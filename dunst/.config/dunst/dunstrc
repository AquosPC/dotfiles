# Catppuccin Mocha, matched to Hyprland (gaps 20, border 2, rounding 10)
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (20, 20)
    width = 350
    height = (0, 300)
    notification_limit = 5
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    corner_radius = 10
    separator_color = frame
    font = MesloLGS Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    show_age_threshold = 60
    ellipsize = middle
    progress_bar = true
    progress_bar_corner_radius = 4
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#6c7086"
    highlight = "#89b4fa"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#fab387"
    highlight = "#fab387"
    timeout = 0
